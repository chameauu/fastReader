{
  "productName": "FastReader",
  "version": "0.1.0",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "FastReader",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["pdf"],
        "mimeType": "application/pdf"
      },
      {
        "ext": ["epub"],
        "mimeType": "application/epub+zip"
      },
      {
        "ext": ["txt"],
        "mimeType": "text/plain"
      },
      {
        "ext": ["md"],
        "mimeType": "text/markdown"
      }
    ]
  },
  "plugins": {}
}
